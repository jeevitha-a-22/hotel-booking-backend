          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"checkIn\": \"2030-03-10T14:00:00.000Z\",\n  \"checkOut\": \"2030-03-12T11:00:00.000Z\",\n  \"guests\": 1\n}" }, "url": "{{baseUrl}}/api/bookings" },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "pm.test('HTTP 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('cancellationBookingId', data.booking._id);"] } }]
        },
        {
