          "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/bookings/{{cancellationBookingId}}/cancel" },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('status is Cancelled', () => pm.expect(data.booking.status).to.eql('Cancelled'));", "pm.test('refund percentage exists', () => pm.expect(data.refundPercentage).to.be.a('number'));"] } }]
        }
      ]
